{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Keycloak": {
    "Authority": "http://localhost:8080/realms/dev",
    "ValidAudiences": [ "account", "core-bancario-backend" ],
    "RequireHttpsMetadata": false
  },

  "ConnectionStrings": {
    "Directorio": "Server=localhost;Database=CoreBancarioDir;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:3000" ]
  },

  "Borradores": {
    "DiasVigencia": 30
  }
}
