# Copia este archivo a .env.local y ajusta si tu Keycloak/API corren en otro host/puerto.

VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/dev
VITE_KEYCLOAK_CLIENT_ID=core-bancario-frontend

VITE_API_BASE_URL=http://localhost:5003

# Minutos de inactividad antes de cerrar la sesion (aviso 60 s antes). Opcional, por defecto 15.
VITE_INACTIVIDAD_MINUTOS=15
